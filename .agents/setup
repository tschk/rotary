#!/usr/bin/env bash
# Idempotent orb bootstrap for rotary (rx4): Rust toolchain + lockfile fetch.
set -euo pipefail

step() {
  local label="$1"
  shift
  local start
  start="$(date +%s)"
  echo "[setup] ${label}"
  "$@"
  echo "[setup] ${label} ($(( $(date +%s) - start ))s)"
}

need_apt=()
for pkg in build-essential pkg-config libssl-dev ca-certificates curl git; do
  if ! dpkg -s "$pkg" >/dev/null 2>&1; then
    need_apt+=("$pkg")
  fi
done
if ((${#need_apt[@]})); then
  step "apt-get update" sudo apt-get update -y
  step "apt-get install" sudo apt-get install -y "${need_apt[@]}"
fi

if [[ ! -x "${HOME}/.cargo/bin/rustup" && ! -x /usr/local/cargo/bin/rustup ]]; then
  if ! command -v rustup >/dev/null 2>&1; then
    step "install rustup" bash -lc \
      'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal'
  fi
fi

# shellcheck disable=SC1091
if [[ -f "${HOME}/.cargo/env" ]]; then
  # Source for the rest of this script; login shells pick it up via bash_profile.
  . "${HOME}/.cargo/env"
fi

if ! command -v rustup >/dev/null 2>&1; then
  echo "[setup] rustup not on PATH after install" >&2
  exit 1
fi

step "rustup toolchain" rustup toolchain install stable --profile minimal --component rustfmt,clippy
step "rustup default" rustup default stable

profile_marker="# rotary rust toolchain"
if [[ -f "${HOME}/.bash_profile" ]] && grep -Fqx "$profile_marker" "${HOME}/.bash_profile" 2>/dev/null; then
  :
else
  cat >> "${HOME}/.bash_profile" <<'EOF'

# rotary rust toolchain
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi
EOF
fi

if [[ -f Cargo.lock ]]; then
  step "cargo fetch" cargo fetch --locked
else
  step "cargo fetch" cargo fetch
fi

echo "[setup] rustc $(rustc --version)"
echo "[setup] cargo $(cargo --version)"
echo "[setup] done"
