+    #[test]
+    fn merge_sessions() {
+        let mut s1 = Session::new("s1", "test1");
+        s1.append(Role::User, "hello");
+
+        let mut s2 = Session::new("s2", "test2");
+        s2.append(Role::Assistant, "world");
+        s2.append(Role::User, "ping");
+
+        let merged_count = s1.merge(&s2);
+
+        assert_eq!(merged_count, 2);
+        assert_eq!(s1.entries.len(), 3);
+        assert_eq!(s1.entries[1].content, "world");
+        assert_eq!(s1.entries[2].content, "ping");
+    }
